# Polaris 服务器部署环境变量。复制为 .env 后填写：
#   cp .env.server.example .env
# （根目录已有的 .env.example 是桌面/旧模板，服务器部署以本文件为准）

# ── 访问口令（留空 = 免口令，谁连上谁能用）──
# 家用 NAS / 内网部署留空即可：NAS 在路由 NAT 后面没有固定公网 IP，公网连不上，
# 而口令忘了没有找回入口，反而会把自己人锁在门外。
# **真把服务暴露到公网**（有公网 IP / 端口映射 / 反代域名）时才填，填了则所有来源一律校验。
# 另两个可选开关：POLARIS_REQUIRE_LOGIN=1 改为一律要账号登录；
#               POLARIS_LAN_ONLY=1 免口令但只放行内网来源。
POLARIS_AUTH_TOKEN=

# Web 端口默认只监听宿主机 loopback，公网请由 Caddy/Nginx/Traefik 以 HTTPS 反代。
# 仅可信内网调试才改为 0.0.0.0（此时流量仍是明文）。
POLARIS_BIND_IP=127.0.0.1

# 协作项目只允许绑定此受控目录内已经存在的本地 Git 仓库（容器内路径）。
POLARIS_REPO_ROOT=/home/polaris/Polaris/repos

# ── 接入 LLM（三选一）──
# A. Claude 官方 API Key
ANTHROPIC_API_KEY=

# B. 第三方 Anthropic 兼容端点（智谱/Kimi/DeepSeek/聚合站等）：
#    填 BASE_URL + AUTH_TOKEN，留空 ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# C. Claude 订阅 OAuth：容器起来后进 App「供应商」面板登录，无需在此填写

# ── 邮箱服务（注册验证码 / 找回密码）──
# QQ 邮箱:HOST=smtp.qq.com PORT=465,PASS 填「SMTP 授权码」(QQ邮箱→设置→账号→
# 开启 SMTP 服务后短信验证领取,不是 QQ 密码)。USER+PASS 配齐即自动开放邮箱自助注册;
# 想关掉自助注册(只留邀请票据入伙)设 POLARIS_EMAIL_SIGNUP=0。
# 也可以不在这里填,owner 登录 Web 后在「互联 → 设备与授权 → 邮箱服务」面板里配置。
POLARIS_SMTP_HOST=smtp.qq.com
POLARIS_SMTP_PORT=465
POLARIS_SMTP_USER=
POLARIS_SMTP_PASS=
POLARIS_SMTP_FROM=
POLARIS_EMAIL_SIGNUP=

# ── 账号权威（「一个账号在哪台机器都能登」）──
#
# 不设这两个 = 老行为：本机 collab.db 自己管账号，各主机各一座孤岛。
#
# ① 云机（账号中心）：设为 1。它持账号签名私钥（~/Polaris/data/account_authority.key，
#    **必须随数据卷一起备份**，丢了所有成员主机都得重新信任），对外发号：
#    注册 / 登录 / 改密，签发 5 分钟有效的身份断言。
#    开户方式：owner 登录 Web 后进「互联 → 设备与授权」，在「新建账号」里直接开号
#    （远程账号管理：建号 / 改昵称邮箱角色 / 重置密码 / 停用 / 删号，不必 SSH 进服务器）。
#    自助注册默认关闭（放开等于把本机成员资格发给公网，见下条）；只有要开自助注册时
#    才需要把 POLARIS_SMTP_* 配齐（验证码要发得出去）。
POLARIS_ACCOUNT_AUTHORITY=
#
# ①-b 开放自助注册（默认关，邀请制）。设 1 才允许陌生人自己在账号中心注册；
#     日常运维用上面的 owner 远程建号即可，不建议开。
POLARIS_ACCOUNT_OPEN_SIGNUP=
#
# ② 成员主机（家里的桌面 / NAS）：填云机地址，本机不再自己判密码，
#    只认云机签的身份断言。公钥首次接触即钉死（TOFU），之后**离线也能验** ——
#    云机挂了不影响成员主机放人进来。公钥变了一律拒绝，须 owner 走「重新信任」确认。
#    注意：填了它，本机的注册/邀请码建号入口会关闭（账号只能在云端注册）。
POLARIS_ACCOUNT_AUTHORITY_URL=
#
# ③ 签名私钥路径（可选，默认 ~/Polaris/data/account_authority.key）
POLARIS_ACCOUNT_KEY=

# ══════════════════════════════════════════════════════════════
# 互联（iroh 隧道 / 远程盘）
# ══════════════════════════════════════════════════════════════
#
# ① 固定 UDP 端口（强烈建议设）
#    iroh 默认随机绑 UDP 口。跑在容器里时这是致命的：端口每次重启都变 → docker
#    没法发布、防火墙没法放行 → 外面永远打不进来 → 打洞必失败、全部流量绕公共中继。
#    这个故障**不报错**，只表现为"能用但很慢"：实测往返 12ms 变 370ms、盘慢 30 倍。
#    设了它还要两件事：compose 已发布同一个 UDP 口（默认就是）、云安全组放行它。
POLARIS_IROH_PORT=41641
#
# ② 中继（可选）。逗号分隔。打洞成功时用不上，打洞失败时它是唯一兜底。
#    不设 = 用 n0 公共中继（可能在欧洲，每跳几百毫秒）。自建中继走明文 http:// 即可
#    （载荷本来端到端加密，中继只见密文；用 https 反而要求证书类型 rustls 认得）。
POLARIS_RELAYS=
#
# ③ 主机隧道开机自启。不设的话，每次容器重建后都要手动
#    `curl -X POST .../api/collab/tunnel/start`，否则对端永远等不到应答。
POLARIS_TUNNEL_AUTOSTART=1
#
# ④ 性能旋钮（留空 = 自适应，一般不用动）
#    WORKERS  隧道 runtime 线程数，默认取 CPU 核数（夹在 2~8）
#    BUF_KB   转发缓冲，默认 256（内存紧张的 NAS 可调到 32）
#    每条活跃流两个方向各占一份 BUF_KB，空闲流不占。
POLARIS_TUNNEL_WORKERS=
POLARIS_TUNNEL_BUF_KB=
#
# ⑤ 远程盘传输压缩（zstd）。默认 3；设 0 关闭。
#    只对**本产品自己的挂载桥**生效（认私有标记头，不是 Accept-Encoding），
#    浏览器/curl 拿到的永远是原文。文本/代码/日志能压掉几倍 —— 这是拿服务器
#    闲着的 CPU 去换带宽，在小带宽机器上收益最大；千兆内网上可以关掉。
POLARIS_FS_ZSTD_LEVEL=

# ── Gitea 管理员（初始化协作 git 托管时用，见 DEPLOY-CLOUD.md）──
GITEA_ADMIN_USER=polaris-admin
GITEA_ADMIN_PASSWORD=
GITEA_ADMIN_EMAIL=admin@example.com
